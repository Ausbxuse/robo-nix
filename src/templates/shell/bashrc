if [ -f "$HOME/.bashrc" ]; then . "$HOME/.bashrc"; fi
__robo_prompt_prefix() {
  __robo_prompt_profile="${ROBO_NIX_PROFILE_SELECTOR:-${ROBO_NIX_PROFILE:-default}}"
  __robo_prompt_color="\[\033[90m\][\[\033[37m\]ro\[\033[36m\]bo\[\033[90m\]:\[\033[36m\]${__robo_prompt_profile}\[\033[90m\]]\[\033[0m\]"
  __robo_prompt_ansi_39="$(printf '\033[90m[\033[39m\033[37mro\033[39m\033[36mbo\033[39m\033[90m:\033[39m\033[36m%s\033[39m\033[90m]\033[39m' "$__robo_prompt_profile")"
  __robo_prompt_ansi_0="$(printf '\033[90m[\033[0m\033[37mro\033[0m\033[36mbo\033[0m\033[90m:\033[0m\033[36m%s\033[0m\033[90m]\033[0m' "$__robo_prompt_profile")"
  __robo_prompt_plain="[robo:${__robo_prompt_profile}]"
  __robo_prompt_base="${PS1-}"
  __robo_strip_prompt_marker() {
    __robo_marker="$1"
    if [ -z "$__robo_marker" ]; then return 1; fi
    case "$__robo_prompt_base" in
      "$__robo_marker"*)
        __robo_prompt_base="${__robo_prompt_base#"$__robo_marker"}"
        return 0
        ;;
    esac
    case "$__robo_prompt_base" in
      \(*\)\ "$__robo_marker"*)
        __robo_prompt_before="${__robo_prompt_base%%"$__robo_marker"*}"
        __robo_prompt_after="${__robo_prompt_base#*"$__robo_marker"}"
        case "$__robo_prompt_before" in
          \(*\)\ )
            __robo_prompt_base="${__robo_prompt_before}${__robo_prompt_after}"
            return 0
            ;;
        esac
        ;;
    esac
    return 1
  }
  while true; do
    __robo_strip_prompt_marker "${__robo_prompt_last_color:-}" && continue
    __robo_strip_prompt_marker "${__robo_prompt_last_ansi_39:-}" && continue
    __robo_strip_prompt_marker "${__robo_prompt_last_ansi_0:-}" && continue
    __robo_strip_prompt_marker "${__robo_prompt_last_plain:-}" && continue
    __robo_strip_prompt_marker "$__robo_prompt_color" && continue
    __robo_strip_prompt_marker "$__robo_prompt_ansi_39" && continue
    __robo_strip_prompt_marker "$__robo_prompt_ansi_0" && continue
    __robo_strip_prompt_marker "$__robo_prompt_plain" && continue
    __robo_strip_prompt_marker "\[\033[90m\][\[\033[37m\]ro\[\033[36m\]bo\[\033[90m\]]\[\033[0m\]" && continue
    __robo_strip_prompt_marker "$(printf '\033[90m[\033[39m\033[37mro\033[39m\033[36mbo\033[39m\033[90m]\033[39m')" && continue
    __robo_strip_prompt_marker "$(printf '\033[90m[\033[0m\033[37mro\033[0m\033[36mbo\033[0m\033[90m]\033[0m')" && continue
    __robo_strip_prompt_marker "[robo]" && continue
    break
  done
  unset -f __robo_strip_prompt_marker
  __robo_prompt_last_color="$__robo_prompt_color"
  __robo_prompt_last_ansi_39="$__robo_prompt_ansi_39"
  __robo_prompt_last_ansi_0="$__robo_prompt_ansi_0"
  __robo_prompt_last_plain="$__robo_prompt_plain"
  PS1="${__robo_prompt_color}${__robo_prompt_base}"
}
__robo_shell_refresh() {
  local __robo_refresh_output
  __robo_refresh_output="$(robo __shell-refresh bash)" || return $?
  eval "$__robo_refresh_output"
}
if [ -n "${ROBO_NIX_PROMPT_PREFIX:-}" ]; then PROMPT_COMMAND="${PROMPT_COMMAND:+${PROMPT_COMMAND}; }__robo_shell_refresh && __robo_prompt_prefix"; __robo_shell_refresh && __robo_prompt_prefix; fi
